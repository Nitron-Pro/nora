{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nora Base",
  "version": "1.7.0",
  "identifier": "com.nora.base",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nora Base",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://localhost:8080/updates/releases.json"
      ]
    }
  }
}